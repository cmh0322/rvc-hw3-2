{
  "modules": [
    [
      "Main",
      "Root",
      "Initialize once, then receive and dispatch one ordered input event at a time."
    ],
    [
      "Initialize RVC",
      "Root",
      "Reset movement, D3 and Sensor Store; acquire initial samples. Return only when all four samples are valid; emit no command (C12/C13)."
    ],
    [
      "Acquire Initial Inputs",
      "Root",
      "Until Inputs Ready, obtain InitialSensors events and dispatch only sensor inputs. Preserve all intermediate TRUE dust observations."
    ],
    [
      "Dispatch Input Event",
      "Root",
      "For a sensor event call Dispatch Sensor Input; for Tick call Controller once. The branches are mutually exclusive."
    ],
    [
      "Dispatch Sensor Input",
      "Afferent",
      "Route front/left/right values to Detect Obstacle and dust values to Detect Dust. Never call Controller or any output module."
    ],
    [
      "Controller",
      "Root",
      "For one Tick: Get Inputs, Decide Actions, Put Outputs. No sensor dispatch interleaves with this cycle."
    ],
    [
      "Get Inputs",
      "Afferent",
      "Read a valid D1 snapshot and classify it. Dust is read directly by Track Power-Up through the Sensor Store accessor."
    ],
    [
      "Detect Obstacle",
      "Afferent",
      "Update only the named D1 sensor field and its valid flag; preserve the other fields (P1)."
    ],
    [
      "Assess Obstacle Situation",
      "Afferent",
      "Produce Front Blocked and Side Situation independently; right priority (C1/C9)."
    ],
    [
      "Detect Dust",
      "Afferent",
      "Set current=value; pending=old_pending OR value; mark dust valid. FALSE preserves pending (P2/C15)."
    ],
    [
      "Reset Sensor Data",
      "Afferent",
      "Set valid flags false and pending=false. Current sensor slots are invalid until populated by actual input; zero is not an assumed reading."
    ],
    [
      "Inputs Ready",
      "Afferent",
      "Return true exactly when front, left, right and dust have all received a valid actual sample."
    ],
    [
      "Get Obstacle Location",
      "Afferent",
      "Return a value copy of the three valid D1 readings. No writable state reference escapes."
    ],
    [
      "Get Dust Existence",
      "Afferent",
      "Return a value copy of D2 current and pending. Does not consume or clear the detection."
    ],
    [
      "Clear Pending Dust",
      "Afferent storage access",
      "Set only pending=false. Leave current and validity unchanged. Called only by Track Power-Up on Forward."
    ],
    [
      "Decide Actions",
      "Central",
      "Select movement, derive Movement Status, track power-up, then decide cleaning."
    ],
    [
      "Movement Controller",
      "Central",
      "Advance D4, take exactly one T1-T14 transition, and restart D4 only when that transition starts a timed step."
    ],
    [
      "Reset Movement Controller",
      "Central",
      "Set Forward state and reset D4 to Idle; return no Movement Command (T0/C13)."
    ],
    [
      "Advance Step Timer",
      "Central",
      "If running, increment elapsed; at 5 emit Step Done and set Idle. Run before the FSM transition."
    ],
    [
      "Start Step Timer",
      "Central",
      "Set elapsed=0 after the transition requests a new step; its command Tick is the first of five."
    ],
    [
      "Reset Step Timer",
      "Central",
      "Set D4 to Idle."
    ],
    [
      "Derive Movement Status",
      "Central",
      "Return Forward for a Forward command, otherwise Avoiding (P3.2.3 central part)."
    ],
    [
      "Track Power-Up",
      "Central",
      "Read D2; preserve D3 and pending while Avoiding. On Forward apply current/pending restart precedence, consume pending, report active and decrement D3."
    ],
    [
      "Reset Power-Up Timer",
      "Central",
      "Set D3=0 as specified by current SA; no cleaning output."
    ],
    [
      "Decide Cleaning",
      "Central",
      "Choose Stop while Avoiding; otherwise Power Up if active, else Start. Use C14 meanings."
    ],
    [
      "Put Outputs",
      "Efferent",
      "Deliver Movement Command through Issue Movement Output, then Clean through Drive Cleaner, within this Tick."
    ],
    [
      "Issue Movement Output",
      "Efferent",
      "Map Movement Command to Direction and call Drive Motor (P3.2.3 efferent part)."
    ]
  ],
  "library_modules": [
    [
      "Receive Input Event",
      "Four sensor terminators and Digital Clock",
      "Input Mode → one Input Event; ordered, lossless received-event contract in section 2"
    ],
    [
      "Drive Motor",
      "Motor",
      "Direction → hardware boundary; no return data"
    ],
    [
      "Drive Cleaner",
      "Cleaner",
      "Clean → hardware boundary; Start/Stop affect suction+mop, Power Up suction only"
    ]
  ],
  "calls": [
    {
      "caller": "Main",
      "callee": "Initialize RVC",
      "input": "—",
      "output": "—",
      "control": "—",
      "when": "once before event loop"
    },
    {
      "caller": "Main",
      "callee": "Receive Input Event",
      "input": "Input Mode=Running",
      "output": "Input Event",
      "control": "—",
      "when": "each event-loop iteration, after initialization"
    },
    {
      "caller": "Main",
      "callee": "Dispatch Input Event",
      "input": "Input Event",
      "output": "—",
      "control": "—",
      "when": "after Receive Input Event returns"
    },
    {
