        "Read Front Sensor",
        "Read Left Sensor",
        "Read Right Sensor"
      ]
    },
    {
      "line": 261,
      "name": "Assess Obstacle Situation",
      "region": "Afferent",
      "responsibility": "Classifies an Obstacle Location: whether the front is blocked, and whether the right is open, only the left is open, or both sides are blocked (C1, C9).",
      "callees": []
    },
