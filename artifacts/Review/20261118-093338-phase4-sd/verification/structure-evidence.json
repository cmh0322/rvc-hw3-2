        "Detect Obstacle",
        "Assess Obstacle Situation",
        "Detect Dust"
      ]
    },
    {
      "line": 260,
      "name": "Detect Obstacle",
      "region": "Afferent",
      "responsibility": "Reads the three obstacle sensors and returns them as one Obstacle Location.",
