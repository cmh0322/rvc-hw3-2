      "line": 256,
      "name": "Main",
      "region": "Root",
      "responsibility": "Initializes the system once, then runs one control cycle for every Tick. Corresponds to the C `main()` function.",
      "callees": [
        "Initialize RVC",
        "Wait For Tick",
        "Controller"
      ]
    },
    {
      "line": 257,
      "name": "Initialize RVC",
      "region": "Root",
      "responsibility": "Puts the system into its power-on condition (FSM transition T0): resets the hidden data and issues the initial Forward command.",
      "callees": [
        "Reset Movement Controller",
        "Reset Power-Up Timer",
        "Issue Movement Output"
      ]
    },
    {
      "line": 258,
      "name": "Controller",
      "region": "Root",
      "responsibility": "Runs one control cycle: obtains the inputs, decides the actions, delivers the outputs. Coordinates Process 0 for one Tick.",
      "callees": [
        "Get Inputs",
        "Decide Actions",
        "Put Outputs"
      ]
    },
    {
      "line": 259,
      "name": "Get Inputs",
